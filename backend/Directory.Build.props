<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591/CS1573: missing XML docs on public members / params — docs are written where they add meaning, not everywhere. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Pin transitive packages listed in Directory.Packages.props too (e.g. EF Core Relational under Npgsql). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <!-- SonarAnalyzer.CSharp is for the habit-hooks dotnet sensor ONLY, which builds with
       -p:CodeAnalysisRuleSet=<its ruleset> and ratchets the structural warnings via the snooze
       baseline. Referencing it unconditionally would flood `typecheck` (`dotnet build
       -warnaserror`): SonarAnalyzer's default-on rules would be elevated to errors across the
       existing code. Scoping the reference to builds that pass a CodeAnalysisRuleSet keeps
       typecheck exactly as strict as before (compiler + built-in CA + NuGetAudit) while the
       sensor's own build gets the analyzer. PrivateAssets=all keeps it build-time only; the
       version comes from Directory.Packages.props (CPM). -->
  <ItemGroup Condition="'$(CodeAnalysisRuleSet)' != ''">
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
  </ItemGroup>
</Project>
