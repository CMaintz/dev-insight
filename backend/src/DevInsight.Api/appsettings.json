{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DevInsight": ""
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Jwt": {
    "Issuer": "devinsight",
    "Audience": "devinsight",
    "SigningKey": "",
    "LifetimeDays": 7
  },
  "GitHub": {
    "ClientId": "",
    "ClientSecret": "",
    "CallbackUrl": "",
    "IncludePrivateRepositories": false
  },
  "GitAnalysis": {
    "MaxRepositorySizeMb": 500,
    "MaxCommits": 5000,
    "CloneTimeoutSeconds": 300
  },
  "AnalysisWorker": {
    "Enabled": true,
    "MaxConcurrency": 2,
    "ScheduledReanalysisHours": 24
  },
  "AiFeedback": {
    "ApiKey": "",
    "Model": "claude-opus-5",
    "MaxFindings": 5
  }
}
