# Copy to .env (git-ignored). Nested settings use double underscores (GitHub__ClientId = GitHub:ClientId).

# GitHub OAuth App — github.com → Settings → Developer settings → OAuth Apps → New.
# Callback URL: http://localhost:8080/api/auth/github/callback (docker compose)
#          or   http://localhost:4200/api/auth/github/callback (npm start + dotnet run)
GitHub__ClientId=
GitHub__ClientSecret=
# Also request the `repo` scope so private repositories can be analysed (grants write access too).
GitHub__IncludePrivateRepositories=false

# At least 32 random bytes, e.g. `openssl rand -base64 48`.
Jwt__SigningKey=

# Optional: enables AI feedback (Anthropic API). Leave empty to use rule-based feedback only.
AiFeedback__ApiKey=
